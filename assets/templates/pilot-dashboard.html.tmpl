];
var EN_SUB=Object.keys(EN).filter(function(k){return k.length>=12||/^\s|\s$/.test(k);}).sort(function(a,b){return b.length-a.length;});
var LANG='en', TR_CACHE={}, TR_ATTRS={'title':1,'aria-label':1,'placeholder':1,'alt':1};
function tr(s){
  if(LANG!=='en'||typeof s!=='string'||!s)return s;
  if(TR_CACHE.hasOwnProperty(s))return TR_CACHE[s];
  var o=s,i;
  if(EN.hasOwnProperty(s))o=EN[s];
  else{
    for(i=0;i<EN_RULES.length;i++)o=EN_RULES[i](o);
    for(i=0;i<EN_SUB.length;i++)if(o.indexOf(EN_SUB[i])>-1)o=o.split(EN_SUB[i]).join(EN[EN_SUB[i]]);
  }
  return TR_CACHE[s]=o;
}
