  var dl=document.getElementById('meList'), logins={}; tickets().forEach(function(t){if(t.assignee)logins[t.assignee]=1;});
  var want=Object.keys(logins).sort().join(',');
  if(dl.getAttribute('data-k')!==want){dl.setAttribute('data-k',want);dl.replaceChildren.apply(dl,Object.keys(logins).sort().map(function(l){return h('option',{value:l});}));}
  var seg=document.getElementById('roleSeg');
  seg.replaceChildren.apply(seg,[['produit','Produit'],['tech','Tech'],['tous','Tous']].map(function(r){
    return h('button',{type:'button','aria-pressed':String(S.role===r[0]),onclick:function(){S.role=r[0];S.page=0;store('cp.role',r[0]);render();}},r[1]);}));
  var alive=S.activity.filter(isAlive).length;
  var tabs=document.getElementById('tabs');
  tabs.replaceChildren.apply(tabs,[['file','Ma file'],['ensemble','Vue d’ensemble'],['recherche','Recherche'],['activite','Activité'+(alive?' ('+alive+')':'')],['design','Design']].map(function(t){
    return h('a',{href:'#'+t[0],'aria-current':S.tab===t[0]?'page':null,onclick:function(){S.tab=t[0];setTimeout(render,0);}},t[1]);}));
}
function render(){
  S._km=null;
  renderChrome();renderConn();renderBanner();
  document.getElementById('idea').hidden=S.tab!=='file';updateIdea();
  document.getElementById('batch').hidden=S.tab!=='file';
  document.getElementById('search').hidden=S.tab!=='recherche';updateSearch();
  document.getElementById('designEdit').hidden=S.tab!=='design';updateDesign();
  document.getElementById('banner').hidden=S.tab==='design';
  var items=subItems(S.tab), ph=PHASES.filter(function(p){return p.key===S.sub.ensemble;})[0];
  if(items.length)subnav(S.tab,items,S.sub[S.tab]); else subnav('',[],'');
  var v=document.getElementById('view');
  v.replaceChildren(S.tab==='ensemble'?(ph?vPhase(ph):vOverview()):S.tab==='recherche'?vSearch():S.tab==='activite'?vActivity():S.tab==='design'?vDesign():vFile());
}

/* ---------- boot ---------- */
function fromHash(){
  var p=(location.hash||'').slice(1).split('/'), t=p[0];
  if(t==='file'||t==='ensemble'||t==='recherche'||t==='activite'||t==='design')S.tab=t;
  var list=SUBS[S.tab];
  if(list&&p[1]&&p[1]!==S.sub[S.tab]&&list.some(function(s){return s[0]===p[1];}))setSub(S.tab,p[1]);
}
window.addEventListener('hashchange',function(){fromHash();render();});
fromHash();
var me=document.getElementById('meInput'); me.value=S.me;
me.addEventListener('input',function(){S.me=me.value.trim().replace(/^@/,'');store('cp.me',S.me);S.page=0;render();});
buildIdea();
buildBatch();
buildSearch();
buildDesign();
render();
if(window.claude&&window.claude.use){
  window.claude.use('db').then(function(d){S.db=d;watchSnapshots();watchLive();}).catch(function(){S.db=null;watchSnapshots();});
}else{
  S.gh={state:'none',msg:'Ouvrez cette page dans claude.ai pour lire les données.',live:[],at:null};render();
}
})();
</script>

