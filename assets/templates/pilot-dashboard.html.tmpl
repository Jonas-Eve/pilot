/* ---------- search: keyword (case- and accent-insensitive "contains", every word must match) + level + type ---------- */
var LEVEL_FR={epic:'epic',story:'story',task:'tâche'}, LEVELS=['epic','story','task'], TYPES=['feature','tech','bug','e2e'];
function fold(x){return String(x==null?'':x).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();}
function matches(t){
  var hay=fold('#'+t.n+' '+t.title), words=fold(S.q).split(/\s+/).filter(Boolean), i;
  for(i=0;i<words.length;i++)if(hay.indexOf(words[i].replace(/^#/,''))<0)return false;
  var lv=LEVELS.filter(function(k){return S.levels[k];}), ty=TYPES.filter(function(k){return S.types[k];});
  if(lv.length&&lv.indexOf(lab(t,'level:'))<0)return false;
  if(ty.length&&ty.indexOf(lab(t,'type:'))<0)return false;
  var st=Object.keys(S.states).filter(function(k){return S.states[k];}), fl=Object.keys(S.flags).filter(function(k){return S.flags[k];});
  if(st.length&&st.indexOf(t.status||'none')<0)return false;
  if(fl.length&&!fl.some(function(k){return has(t,k);}))return false;
  var as=Object.keys(S.assignees).filter(function(k){return S.assignees[k];});
  if(as.length&&!as.some(function(k){return k==='me'?(!!S.me&&t.assignee===S.me):k==='none'?!t.assignee:t.assignee===k;}))return false;
  return true;
}
var FGROUPS=[['levels','Niveau'],['types','Type'],['states','État'],['assignees','Assigné'],['flags','Drapeau']];
function filterName(map,k){
  if(map==='levels')return LEVEL_FR[k]||k;
  if(map==='states')return k==='none'?'sans statut':(STATUS_FR[k]||k);
  if(map==='flags')return FLAG_FR[k]||k;
  if(map==='assignees')return k==='me'?'moi':k==='none'?'non assigné':'@'+k;
  return k;
}
function activeFilters(){
