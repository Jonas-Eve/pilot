function setLang(l,user){
  LANG=pickLang(l);if(user)store('cp.lang',LANG);TR_CACHE={};applyStatic();
  if(!BUILT)return;
  var keep={}; TYPED.forEach(function(i){var e=document.getElementById(i);if(e)keep[i]=e.value;}); /* the forms are built once, in the language of the moment: rebuild them, keeping what was typed */
  ['idea','search','protoNew','designEdit'].forEach(function(i){document.getElementById(i).replaceChildren();});
