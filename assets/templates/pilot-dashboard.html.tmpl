    ])),
    sec('La commande de chaque statut','The command of each status'),
    simpleTable([L('Statut','Status'),L('Commande qui le prend','Command that takes it')],next));
}

var HOW_TABS=[
  {id:"file",mod:"",
    fr:{title:"Travail",what:"Les tickets ouverts (epics, stories, tâches, prototypes en cours), un board en quatre étapes (À cadrer, En conception, En réalisation, À recetter ; le statut exact est sur la carte) ou une liste groupée par besoin, et les runs en cours : workflow, étape, état. Les compteurs du haut sont des filtres.",how:"Lancez ou reprenez depuis une carte : « Ouvrir » écrit la commande du workflow qui prend le ticket. Un run en pause se relance avec --resume. Le rôle ouvre les étapes qui le concernent (Produit : À cadrer et À recetter ; Tech : En conception et En réalisation) et replie les autres d’un clic ; Tous les ouvre. Filtrez par niveau, type, état, drapeau ou assigné. Le titre d’une carte ouvre la page du ticket : chaîne de statuts avec le temps passé, sous-tickets, et « Workflow », la frise des étapes du run (faites, en cours, à venir, qui agit, ce qui est attendu), aussi sur chaque run en cours.",why:"Vous voyez où s’accumule le travail et ce qui est bloqué, et vous lancez la suite."},
    en:{title:"Work",what:"The open tickets (epics, stories, tasks, prototypes under way), a board in four stages (To frame, In design, In build, To accept; the exact status is on the card) or a list grouped by need, and the runs under way: workflow, step, state. The counters at the top are filters.",how:"Launch or resume from a card: “Open” writes the command of the workflow that takes the ticket. A paused run restarts with --resume. The role opens the stages that concern it (Product: To frame and To accept; Tech: In design and In build) and folds the others in one click; All opens them. Filter by level, type, state, flag or assignee. A card’s title opens the ticket’s page: chain of statuses with the time spent, sub-tickets, and “Workflow”, the timeline of the run’s steps (done, current, upcoming, who acts, what is awaited), also on each run under way.",why:"You see where work piles up and what is blocked, and you launch the next."}},
  {id:"prototypes",mod:"proto",
    fr:{title:"Prototypes",what:"Des maquettes cliquables de fonctions à tester, avec l’état de leur run : en cours, ou terminé (accepté ou rejeté).",how:"Décrivez la fonction dans l’onglet ; reprenez ou rejetez un prototype en cours ; un prototype accepté nourrit un besoin (/pilot-need --proto).",why:"On décide sur du concret avant d’écrire un besoin."},
    en:{title:"Prototypes",what:"Clickable mockups of features to try, with their run’s state: under way, or finished (accepted or rejected).",how:"Describe the feature in the tab; resume or reject a prototype under way; an accepted prototype feeds a need (/pilot-need --proto).",why:"You decide on something concrete before writing a need."}},
  {id:"design",mod:"design",
    fr:{title:"Design",what:"La charte, les couleurs, la typographie, les espacements, les composants et l’accessibilité du produit.",how:"Lisez-la pour rester cohérent ; faites-la évoluer avec /pilot-design.",why:"Les prototypes et les interfaces restent cohérents d’une fonction à l’autre."},
    en:{title:"Design",what:"The product’s charter, colors, typography, spacing, components and accessibility.",how:"Read it to stay consistent; evolve it with /pilot-design.",why:"Prototypes and interfaces stay consistent from one feature to the next."}},
  {id:"wiki",mod:"wiki",
    fr:{title:"Wiki",what:"Ce que fait le produit : vision, personas, comportements, parcours utilisateur, par domaine ; chaque entrée dit si elle est en place ou seulement prévue. Quand le wiki et le code divergent, le wiki a raison.",how:"Parcourez par domaine ; posez une question ou contrôlez le wiki avec /pilot-wiki ; créez un persona ou un parcours avec /pilot-flow ; testez un parcours avec /pilot-accept. Un changement de comportement passe par /pilot-need.",why:"Un référentiel fonctionnel unique que les agents lisent avant d’agir."},
    en:{title:"Wiki",what:"What the product does: vision, personas, behaviors, user flows, by domain; each entry says whether it is in place or only planned. When the wiki and the code disagree, the wiki is right.",how:"Browse by domain; ask a question or lint the wiki with /pilot-wiki; create a persona or a flow with /pilot-flow; test a flow with /pilot-accept. A behavior change goes through /pilot-need.",why:"A single functional reference that agents read before acting."}},
  {id:"architecture",mod:"architecture",
    fr:{title:"Architecture",what:"Comment le produit est construit : vue d’ensemble, règles techniques et référence du code.",how:"Consultez avant une décision technique ; posez une question, ajoutez une règle ou contrôlez le fonds avec /pilot-architecture. Les ADR sont locaux, écrits par /pilot-plan.",why:"Les règles et leurs raisons survivent aux personnes ; ce qui les enfreint est signalé."},
    en:{title:"Architecture",what:"How the product is built: overview, technical rules and code reference.",how:"Check it before a technical decision; ask a question, add a rule or lint the body with /pilot-architecture. ADRs are local, written by /pilot-plan.",why:"Rules and their reasons outlive people; what breaks them is flagged."}}
];
function vHowModules(){
  return h('div',{class:'list'},
    para('Chaque onglet du cockpit, à quoi il sert et pourquoi l’utiliser. Wiki, architecture, design et prototypes sont des modules optionnels : désactivés, leur onglet disparaît et les agents ne les consultent plus. Le filtre de rôle (Produit / Tech / Tous) masque aussi des onglets : choisissez Tous pour tout voir.','Each cockpit tab, what it is for and why to use it. Wiki, architecture, design and prototypes are optional modules: when off, their tab disappears and the agents no longer consult them. The role filter (Product / Tech / All) also hides tabs: pick All to see everything.'),
    h('div',{class:'agents'},HOW_TABS.map(function(t){
      var x=L(t.fr,t.en), on=moduleOn(t.id), hid=on&&!roleShows(t.id);
      var badge=t.mod?(on?(hid?L('masqué par le rôle','hidden by role'):L('actif','on')):L('désactivé','off')):(hid?L('masqué par le rôle','hidden by role'):'');
      var rows=[[L('Rôle :','What:'),x.what],[L('Comment :','How:'),x.how],[L('Intérêt :','Why:'),x.why]];
      if(t.mod&&!on)rows.push([L('Activer :','Enable:'),'python3 .pilot/pilot.py module enable '+t.mod]);
      return helpCard(x.title,badge,rows);
    })),
    sec('D’où viennent les données du cockpit','Where the cockpit’s data comes from'),
    para('GitHub reste la vérité. Le cockpit lit un instantané de vos tickets, pris par /pilot-dashboard --refresh, et y ajoute en direct les changements de ticket et les étapes de run que les workflows lui envoient. Ces envois sont faits au mieux : un échec ne bloque jamais un run, et un instantané ancien se rafraîchit. Tant qu’aucun instantané n’existe, des données d’exemple sont affichées.','GitHub remains the truth. The cockpit reads a snapshot of your tickets, taken by /pilot-dashboard --refresh, and adds live the ticket changes and run steps the workflows send it. These pushes are best-effort: a failure never blocks a run, and an old snapshot is refreshed. Until a snapshot exists, sample data is shown.'));
}
function vHelp(){
  var sub=S.sub.aide;
  var lang=h('div',{class:'pair'},h('span',{class:'note'},'Langue'),h('div',{class:'seg',role:'group','aria-label':'Langue',id:'langSeg'},['fr','en'].map(function(l){return h('button',{type:'button',lang:l,'aria-pressed':String(LANG===l),onclick:function(){setLang(l,true);}},l.toUpperCase());})));
  var HOW={principes:vHowPrinciples,workflows:vHowWorkflows,tickets:vHowTickets,modules:vHowModules};
  if(HOW[sub])return h('div',{class:'list'},lang,HOW[sub]());
  return h('div',{class:'list'},lang,h('div',{class:'agents'},AGENTS.map(function(a){return helpCard(a[1],'',[[L('Rôle :','What:'),L(a[2],a[3])],[L('Intervient dans :','Takes part in:'),agentIn(a[0])||'—']]);})));
}
var HELP_SUBS=[['principes','Principes'],['workflows','Workflows'],['tickets','Tickets'],['modules','Modules'],['agents','Agents']];

/* ---------- boot ---------- */
function fromHash(){
  var p=(location.hash||'').slice(1).split('/'), t=p[0];
  S.viewProto=0; S.viewHelp=t==='aide'?1:0; S.wf=t==='file'&&/^\d+$/.test(p[1]||'')?Number(p[1]):0;
  if(S.viewHelp&&p[1]&&HELP_SUBS.some(function(s){return s[0]===p[1];}))S.sub.aide=p[1];
  if(t==='proto'){S.tab='prototypes';S.viewProto=Number(p[1])||0;}
  else if(t==='file')S.tab='file';
  else if(t==='design'||t==='prototypes'||t==='wiki'||t==='architecture')S.tab=t;
  var list=SUBS[S.tab];
  if(p[1]&&list&&list.some(function(s){return s[0]===p[1];}))S.sub[S.tab]=p[1];
  else if(p[1]&&(S.tab==='wiki'||S.tab==='architecture'))S.sub[S.tab]=p[1];
}
window.addEventListener('hashchange',function(){fromHash();render();});
fromHash();
markStatic();
var sv0=store('cp.lang'); setLang(sv0==='fr'||sv0==='en'?sv0:'en',false);
var me=document.getElementById('meInput'); me.value=S.me;
me.addEventListener('input',function(){S.me=me.value.trim().replace(/^@/,'');store('cp.me',S.me);render();});
buildIdea();
buildSearch();
buildDesign();
buildProtoNew();
BUILT=true;
render();
if(window.claude&&window.claude.use){
  window.claude.use('db').then(function(d){S.db=d;watchSnapshots();watchLive();}).catch(function(){S.db=null;watchSnapshots();});
}else{
  S.gh={state:'none',msg:'Ouvrez cette page dans claude.ai pour lire les données.',live:[],at:null};render();
}
})();
</script>
