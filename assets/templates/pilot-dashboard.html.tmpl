var ARCH_GROUPS={overview:'Vue d’ensemble',guidelines:'Règles',reference:'Référence',adr:'Décisions',runbooks:'Procédures'};
function archEntries(){return S.arch&&Array.isArray(S.arch.entries)?S.arch.entries.slice(0,2000):[];}
function archGroup(e){var p=str(e.path,200).split('/'); if(p[0]==='apps'&&p.length>2)return 'app:'+str(p[1],60); return p.length>1&&ARCH_GROUPS[p[0]]?p[0]:'overview';}
function archLabel(g){return g.indexOf('app:')===0?'App '+g.slice(4):ARCH_GROUPS[g]||g;}
function archGroups(){
  var n={}; archEntries().forEach(function(e){var g=archGroup(e); n[g]=(n[g]||0)+1;});
  var keys=Object.keys(ARCH_GROUPS).filter(function(g){return n[g];}).concat(Object.keys(n).filter(function(g){return g.indexOf('app:')===0;}).sort());
  return keys.map(function(g){return [g,archLabel(g),n[g]];});
}
/* what a person can ask of an entry, as a command written for Claude Code: only a PR changes the architecture */
function archActions(e){
  var id=str(e.id,80); if(!FLOW_ID.test(id))return null;
  var adr=/(^|\/)adr\//.test(str(e.path,200)), live=e.status==='proposed'||(e.status==='accepted'&&!adr), acts=[]; /* an accepted ADR is replaced by a later one, never edited */
  if(e.status==='proposed')acts.push(openLink(sk('technical-frame')+' --accept '+id,'Accepter',true));
  if(live)acts.push(openLink(sk('technical-frame')+' --edit '+id+' ','Modifier'));
  if(live&&str(e.path,200)!=='overview.md')acts.push(openLink(sk('technical-frame')+' --remove '+id,'Retirer'));
