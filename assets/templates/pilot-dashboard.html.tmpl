  var tog=h('button',{type:'button',class:'btn',id:'filtersToggle','aria-expanded':String(open),'aria-controls':'searchFilters',
    onclick:function(){var o=panel.hidden;panel.hidden=!o;tog.setAttribute('aria-expanded',String(o));chev.textContent=o?'▾':'▸';store('cp.fold.filters',o?'1':'0');}},
    chev,' Filtres ',h('span',{class:'chip acc',id:'filtersCount',hidden:true},'0'));
  box.append(
    h('h2',{},'Recherche'),
