    };
    f.replaceChildren(grp('Niveau',LEVELS,'levels'),grp('Type',TYPES,'types'),grp('État',keys,'states'),grp('Assigné',akeys,'assignees'),grp('Drapeau',['needs-human','on-hold'],'flags'));
