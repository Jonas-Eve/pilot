var STATE_ORDER=['draft','backlog','in-spec','dev-ready','in-dev','changes-requested','review-ready','in-review','approved','qa','in-qa','split'];
var FLAG_FR={'needs-human':'attend un humain','on-hold':'en pause'};
function stateKeys(){
