<title>Cockpit {{PROJECT_NAME}}</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
<style>
/* Layout: sticky control strip on top, tabs below (Travail with its runs and its #file/N detail, Prototypes, Design, Wiki, Architecture). Cool paper neutrals, cobalt accent, semantic colors kept separate. */
:root{
  --bg:#F2F5F8; --surface:#FFFFFF; --surface2:#E9EEF3; --line:#D5DDE5;
  --fg:#121C26; --muted:#566677; --accent:#1747C9; --accent-fg:#FFFFFF; --accent-soft:#E3EBFD;
  --ok:#17803D; --ok-soft:#DFF3E6; --warn:#8F5200; --warn-soft:#FDEFD3; --crit:#B42318; --crit-soft:#FDE4E1;
  --font:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0E141B; --surface:#151D26; --surface2:#1C2631; --line:#2A3745;
  --fg:#E6ECF2; --muted:#93A3B3; --accent:#7EA2FF; --accent-fg:#0B1220; --accent-soft:#1B2A4D;
  --ok:#4CC27A; --ok-soft:#133323; --warn:#E3A23B; --warn-soft:#3A2B10; --crit:#FF8B7E; --crit-soft:#42201C; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0E141B; --surface:#151D26; --surface2:#1C2631; --line:#2A3745;
  --fg:#E6ECF2; --muted:#93A3B3; --accent:#7EA2FF; --accent-fg:#0B1220; --accent-soft:#1B2A4D;
  --ok:#4CC27A; --ok-soft:#133323; --warn:#E3A23B; --warn-soft:#3A2B10; --crit:#FF8B7E; --crit-soft:#42201C; color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font:14px/1.5 var(--font);
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:20px 56px}
.wrap{max-width:1180px;margin:0 auto;display:flex;flex-direction:column;gap:16px}
h1{font-size:22px;line-height:1.2;margin:0;font-weight:600;letter-spacing:-.01em}
h2{font-size:13px;margin:0;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.mono{font-family:var(--mono)}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.top{display:flex;flex-wrap:wrap;gap:12px 20px;align-items:flex-end;justify-content:space-between}
.top .sub{color:var(--muted);margin:2px 0 0}
.controls{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--surface)}
.seg button{border:0;background:transparent;padding:6px 12px;min-height:34px}
.seg button+button{border-left:1px solid var(--line)}
.seg button[aria-pressed="true"]{background:var(--accent);color:var(--accent-fg)}
.repo{display:flex;gap:6px;align-items:center}
.repo input{border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:6px 10px;min-height:34px;width:min(220px,100%);font-family:var(--mono);font-size:13px}
.btn{border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:6px 12px;min-height:34px}
.btn:hover{border-color:var(--accent)}
a.btn{color:inherit;text-decoration:none;display:inline-flex;align-items:center}
.btn.ghost{background:transparent;border-color:transparent;color:var(--muted);padding-inline:8px}
.btn.ghost:hover{border-color:var(--line)}
a.btn.primary{color:var(--accent-fg)}
.btn.primary{background:var(--accent);color:var(--accent-fg);border-color:var(--accent)}
.btn.danger{color:var(--crit);border-color:var(--crit)}
.btn[disabled]{opacity:.5;cursor:not-allowed}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:1px 9px;font-size:12px;line-height:20px;background:var(--surface2);color:var(--muted);white-space:nowrap}
.chip.ok{background:var(--ok-soft);color:var(--ok)} .chip.warn{background:var(--warn-soft);color:var(--warn)} .chip.crit{background:var(--crit-soft);color:var(--crit)} .chip.acc{background:var(--accent-soft);color:var(--accent)}
.dot{width:7px;height:7px;border-radius:50%;background:currentColor;display:inline-block}
nav.tabs{display:flex;gap:4px;border-bottom:1px solid var(--line);overflow-x:auto}
nav.tabs a{padding:8px 14px;color:var(--muted);text-decoration:none;border-bottom:2px solid transparent;white-space:nowrap;margin-bottom:-1px}
nav.tabs a[aria-current="page"]{color:var(--fg);border-bottom-color:var(--accent);font-weight:600}
nav.tabs.sub{margin-top:-6px;border-bottom-style:dashed}
nav.tabs.sub a{padding:6px 12px;font-size:13px}
.banner{border:1px solid var(--line);border-left-width:4px;background:var(--surface);border-radius:8px;padding:10px 14px;display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;justify-content:space-between}
.banner.live{border-left-color:var(--ok)} .banner.sample{border-left-color:var(--warn)}
.banner p{margin:0;min-width:0}
.list{display:flex;flex-direction:column;gap:8px}
.row{display:grid;grid-template-columns:1fr auto;gap:8px 14px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 14px}
.row.flag{border-color:var(--warn)}
.row .main{min-width:0}
.row .t{font-weight:500;overflow-wrap:anywhere}
.row .meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;align-items:center}
.row .num{font-family:var(--mono);color:var(--muted)}
.row .acts{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end}
.tally{display:flex;flex-wrap:wrap;gap:8px}
.tile{display:flex;align-items:baseline;gap:6px;background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:6px 12px}
.tile strong{font-size:18px;font-variant-numeric:tabular-nums}
.tile span{color:var(--muted);font-size:13px}
.tile.zero strong{color:var(--muted);font-weight:400}
button.tile{cursor:pointer;font:inherit;color:inherit}
.tile:hover{border-color:var(--accent)}
.tile.on{border-color:var(--accent);background:var(--accent-soft)}
.bar{height:6px;background:var(--surface2);border-radius:3px;overflow:hidden;margin-top:6px}
.bar>i{display:block;height:100%;background:var(--ok)}
.tile.warn{border-color:var(--warn);background:var(--warn-soft)} .tile.warn strong,.tile.warn span{color:var(--warn)}
.banner.compact{padding:4px 10px;font-size:12px;color:var(--muted);border-left-width:1px;background:transparent}
.cmd{font-family:var(--mono);font-size:12px;color:var(--muted)}
.foldcard{display:flex;flex-direction:column;gap:8px;border:1px solid var(--line);border-radius:8px;padding:10px 12px;background:var(--surface)} .foldcard summary{cursor:pointer;font-weight:600} .foldcard .cmd{overflow-wrap:anywhere}
.board{display:grid;grid-template-columns:var(--cols,repeat(4,minmax(0,1fr)));gap:12px;align-items:start;padding-bottom:8px}
.col{background:var(--surface2);border-radius:10px;padding:8px;display:flex;flex-direction:column;gap:8px;min-width:0}
.col .sh{display:flex;justify-content:space-between;align-items:center;gap:8px;width:100%;border:0;background:transparent;padding:4px 2px;text-align:left;min-height:34px;font-weight:600}
.col .sh .chev{color:var(--accent);width:1em;display:inline-block}
.col .sh .nm{flex:1;min-width:0}
.col.shut{padding-block:4px}
@media (max-width:760px){.board{grid-template-columns:1fr}}
.card.child{margin-left:12px;border-left:3px solid var(--line)}
.card .meta2{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:4px}
.card .prog{font-family:var(--mono);font-size:12px;color:var(--muted)}
.card a.up{font-size:12px;color:var(--muted);text-decoration:none}
.card a.up:hover{text-decoration:underline}
.card .bar{margin-top:4px}
.done-fold{margin-top:4px}
.tlwrap{grid-column:1/-1;border-top:1px dashed var(--line);padding-top:8px}
.tl{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px}
.tl li{display:grid;grid-template-columns:22px 1fr;gap:2px 8px;padding:4px 6px;border-radius:6px;align-items:start}
.tl li .mk{font-family:var(--mono);color:var(--muted);text-align:center}
.tl li.done .mk{color:var(--ok)} .tl li.cur{background:var(--accent-soft)} .tl li.cur .mk{color:var(--accent)} .tl li.cur.wait{background:var(--warn-soft)}
.tl li.next{color:var(--muted)}
.tl .ti{font-weight:500;overflow-wrap:anywhere} .tl li.next .ti{font-weight:400}
.tl .sub{grid-column:2;display:flex;flex-wrap:wrap;gap:4px 6px;align-items:center}
.card{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:8px 10px;min-width:0}
.card.flag{border-color:var(--warn)}
.card.g-human{border-color:var(--warn);background:var(--warn-soft)}
.card.g-going{border-left:3px solid var(--accent)}
.card.g-pause{border-style:dashed;opacity:.8}
.card .t a{color:inherit;text-decoration:none}
.card .t a:hover{text-decoration:underline}
a.chip{text-decoration:none;color:var(--muted)}
a.chip:hover{text-decoration:underline}
.crumbs{font-size:13px;color:var(--muted);display:flex;flex-wrap:wrap;gap:4px}
.crumbs a{color:var(--accent);text-decoration:none}
.crumbs a:hover{text-decoration:underline}
.card .acts{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.col header .chips{flex-wrap:nowrap}
.card .t{font-size:13px;overflow-wrap:anywhere}
.card .meta{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px}
.empty{color:var(--muted);font-size:13px;padding:14px;border:1px dashed var(--line);border-radius:10px;text-align:center}
.note{color:var(--muted);font-size:13px;margin:0}
.note.ok{color:var(--ok)} .note.crit{color:var(--crit)}
.refresh{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center}
.idea{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:12px 14px;display:flex;flex-direction:column;gap:8px}
.ttl{display:flex;align-items:center;gap:10px}
.info{flex:none;width:26px;height:26px;border-radius:50%;border:1px solid var(--line);color:var(--muted);display:inline-flex;align-items:center;justify-content:center;text-decoration:none;font:italic 600 14px/1 Georgia,serif;align-self:center}
.info:hover,.info[aria-current="page"]{color:var(--fg);border-color:var(--muted)}
.ref{overflow-x:auto}
.ref table{border-collapse:collapse;width:100%;font-size:13px}
.ref th,.ref td{text-align:left;padding:6px 8px 6px 0;border-bottom:1px solid var(--line);vertical-align:top}
.ref thead th{white-space:nowrap}
.ref th{color:var(--muted);font-weight:600}
.agents{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:8px}
.agents .row{margin:0}
.idea input[type=url]{width:100%;border:1px solid var(--line);background:var(--bg);border-radius:8px;padding:8px 10px;font:inherit;color:inherit}
.idea textarea{width:100%;min-height:72px;border:1px solid var(--line);background:var(--bg);border-radius:8px;padding:8px 10px;font:inherit;color:inherit;resize:vertical}
[hidden]{display:none!important}
.foot{color:var(--muted);font-size:12px;font-family:var(--mono);text-align:center;padding-top:8px}
.fold{display:flex;align-items:center;gap:8px;width:100%;border:0;background:transparent;padding:0;text-align:left;font-weight:600;text-transform:uppercase;letter-spacing:.06em;font-size:13px;color:var(--muted)}
.fold .chev{display:inline-block;width:1em;color:var(--accent)}
.fold .sum{margin-left:auto;text-transform:none;letter-spacing:0;font-weight:400}
.foldbody{display:flex;flex-direction:column;gap:8px;margin-top:8px}
.kids{grid-column:1/-1;display:flex;flex-direction:column;gap:8px;margin-left:10px;padding-left:10px;border-left:2px solid var(--line)}
.kids .row{background:var(--bg)}
.idea .cmd{overflow-wrap:anywhere}
.search input[type=search]{width:100%;min-height:38px;border:1px solid var(--line);background:var(--bg);border-radius:8px;padding:6px 10px;font:inherit;color:inherit}
.filters{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center}
.filters .grp{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.me{border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:6px 10px;min-height:34px;width:min(190px,100%);font-family:var(--mono);font-size:13px}
.fpanel{display:flex;flex-direction:column;gap:10px;border-top:1px dashed var(--line);padding-top:10px}
.fgrp{display:flex;flex-direction:column;gap:6px}
.chip.rm{border:0;cursor:pointer;font:inherit;font-size:12px;line-height:20px}
.tog{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:3px 12px;min-height:30px}
.tog[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-fg)}
.idea .seg{align-self:flex-start;max-width:100%;overflow-x:auto}
.sw{display:inline-block;width:18px;height:18px;border-radius:4px;border:1px solid var(--line);vertical-align:middle;margin-right:6px}
.logo{max-height:64px;max-width:240px;align-self:flex-start}
.pair{display:flex;flex-wrap:wrap;gap:4px 16px;align-items:center}
.prev{width:100%;border:1px solid var(--line);border-radius:8px;background:#fff}
a.btn[aria-disabled="true"]{opacity:.5;pointer-events:none}
@media (max-width:560px){.row{grid-template-columns:1fr}.row .acts{justify-content:flex-start}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>

<div class="wrap">
  <div class="top">
    <div>
      <div class="ttl"><h1>Cockpit {{PROJECT_NAME}}</h1><a class="info" id="helpLink" href="#aide" title="Aide : principes, workflows, tickets, modules et agents" aria-label="Aide : principes, workflows, tickets, modules et agents">i</a></div>
      <p class="sub">Tickets par statut, runs en cours et file d’actions selon votre rôle, avec la commande PILOT prête à copier.</p>
    </div>
    <div class="controls">
      <input class="me" id="meInput" list="meList" autocomplete="off" spellcheck="false" aria-label="Mon identifiant GitHub" placeholder="Mon identifiant GitHub">
      <datalist id="meList"></datalist>
      <div class="seg" role="group" aria-label="Rôle" id="roleSeg"></div>
    </div>
  </div>
  <div class="chips" id="conn" aria-label="État des connecteurs"></div>
  <nav class="tabs" id="tabs"></nav>
  <nav class="tabs sub" id="subtabs" aria-label="Sous-onglets" hidden></nav>
  <div id="banner"></div>
  <section id="idea" class="idea" aria-label="Nouvelle demande" hidden></section>
  <section id="search" class="idea search" aria-label="Recherche" hidden></section>
  <section id="protoNew" class="idea" aria-label="Nouveau prototype" hidden></section>
  <section id="designEdit" class="idea" aria-label="Créer ou modifier le design system" hidden></section>
  <main id="view"></main>
  <footer class="foot" id="version">Cockpit PILOT · v{{PILOT_VERSION}} · déployé le {{DEPLOYED_AT}}</footer>
</div>

