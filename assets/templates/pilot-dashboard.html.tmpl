  }).concat(act.length||S.q?[h('button',{class:'btn ghost',type:'button',onclick:clearSearch},'Réinitialiser')]:[]));
}
function vSearch(){
  var res=tickets().filter(matches).sort(function(a,b){return String(b.updated).localeCompare(String(a.updated));});
  var pages=Math.max(1,Math.ceil(res.length/PAGE_SIZE)); if(S.page>=pages)S.page=pages-1; if(S.page<0)S.page=0;
  var shown=res.slice(S.page*PAGE_SIZE,(S.page+1)*PAGE_SIZE);
  return h('div',{class:'list'},
    h('h2',{},'Résultats · '+res.length+' sur '+tickets().length+' tickets ouverts'),
