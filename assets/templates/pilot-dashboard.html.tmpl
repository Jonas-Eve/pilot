/* what a person can launch for a ticket: the skill of the workflow that consumes its status (`--resume` where that workflow already claimed or produced it) */
function actionFor(t){
  var s=t.status, id, c, cmd;
  if(has(t,'on-hold'))return {kind:'hold'};
  if(has(t,'needs-human'))return {kind:'human'};
  for(id in CONTRACTS){
    c=CONTRACTS[id];
    if(c.c.indexOf('status:'+s)<0||!wfOn(id))continue;
    cmd='/pilot-'+id+(id==='need'?'':' '+t.n);
    if(id!=='need'&&(c.k==='status:'+s||c.p.indexOf('status:'+s)>-1))cmd='/pilot-'+id+' --resume '+t.n;
    return {kind:'run',id:id,cmd:cmd,resume:cmd.indexOf('--resume')>-1,label:cmd.indexOf('--resume')>-1?'Reprendre':({need:'Cadrer',plan:'Planifier',build:'Construire',accept:'Recetter'})[id]};
  }
  return {kind:'none'};
}

