function hexOk(x){return /^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/i.test(String(x==null?'':x));}
function sw(hex){return hexOk(hex)?h('span',{class:'sw',style:'background:'+hex,'aria-hidden':'true'}):null;}
function str(x,max){return x==null?'':String(x).slice(0,max||600);}
function arr(x){return Array.isArray(x)?x.slice(0,60):[];}
function clampN(x,lo,hi,dflt){var n=Number(x);return isFinite(n)?Math.min(hi,Math.max(lo,n)):dflt;}
/* a component's preview: a static HTML fragment shown in a frame with no script and no network, themed by the document's own tokens */
function slug(x){return String(x==null?'':x).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,40);}
function tokenCss(d){
  var light=[], dark=[], rest=[], sp=d.space||{}, ty=d.type||{};
  arr(d.colors).forEach(function(c){var k=slug(c.name); if(!k)return; if(hexOk(c.light))light.push('--color-'+k+':'+c.light); if(hexOk(c.dark))dark.push('--color-'+k+':'+c.dark);});
  arr(sp.spacing).forEach(function(x){var k=slug(x.name); if(k&&/^\d+(\.\d+)?(px|rem)$/.test(str(x.value,20)))rest.push('--space-'+k+':'+x.value);});
  arr(sp.radius).forEach(function(x){var k=slug(x.name); if(k&&/^\d+(\.\d+)?(px|rem)$/.test(str(x.value,20)))rest.push('--radius-'+k+':'+x.value);});
  if(/^[\w \-,]{1,80}$/.test(str(ty.family,80)))rest.push('--font:'+ty.family+',system-ui,sans-serif');
  arr(ty.scale).forEach(function(x){var k=slug(x.name); if(k)rest.push('--text-'+k+':'+clampN(x.size,10,48,16)+'px');});
  return ':root{'+light.concat(rest).join(';')+'}@media (prefers-color-scheme:dark){:root{'+dark.join(';')+'}}';
}
var PREVIEW_MAX=4000;
function previewFrame(d,x){
  var html=typeof x.preview==='string'?x.preview:''; if(!html)return null;
  if(html.length>PREVIEW_MAX)return h('p',{class:'note'},'Aperçu trop volumineux pour être affiché.');
  var doc='<!doctype html><meta charset=utf8><meta http-equiv="Content-Security-Policy" content="default-src \'none\'; style-src \'unsafe-inline\'; img-src data:; font-src data:"><style>'+tokenCss(d)+
    'body{margin:0;padding:12px;font:14px/1.5 var(--font,system-ui,sans-serif);color:#121C26;background:#fff}@media (prefers-color-scheme:dark){body{color:#E6ECF2;background:#151D26}}</style>'+html;
  return h('iframe',{class:'prev',title:'Aperçu : '+str(x.name,80),sandbox:'',srcdoc:doc,loading:'lazy',style:'height:'+clampN(x.height,40,400,120)+'px'});
}
